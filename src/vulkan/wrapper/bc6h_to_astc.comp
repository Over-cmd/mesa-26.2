#version 450
/*
 * BC6H (HDR) -> ASTC HDR transcode compute shader.
 * One invocation per ASTC block (supports 4x4, 6x6, and 8x8 ASTC block sizes):
 *   - Decodes BC6H (UF16 / SF16, all 14 modes) to linear/FP16 RGB HDR texels.
 *   - Encodes a 128-bit ASTC HDR block using CEM 11 (HDR RGB Direct, 12-bit endpoints)
 *     and a 4x4 weight grid with 2-bit weights (0..3, block_mode = 0x144).
 *
 * Push constant `block_dim`:
 *   0 or 4 -> 4x4 ASTC block (1x1 BC6H block  = 16 texels)
 *   6      -> 6x6 ASTC block (2x2 BC6H blocks cropped to 6x6 = 36 texels)
 *   8      -> 8x8 ASTC block (2x2 BC6H blocks = 64 texels)
 * `is_signed`:
 *   0 -> BC6H_UF16 (unsigned half-float)
 *   1 -> BC6H_SF16 (signed half-float, clamped >= 0.0 for standard ASTC HDR)
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer SrcBuf { uint src[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { uint dst[]; };

layout(push_constant) uniform PC {
   uint block_x;      /* ASTC grid width  in blocks */
   uint block_x_src;  /* BC6H source stride in blocks */
   uint block_y;      /* ASTC grid height in blocks */
   uint src_word_off; /* Word offset into src[] */
   uint block_dim;    /* 4 (or 0) = 4x4, 6 = 6x6, 8 = 8x8 */
   uint is_signed;    /* 0 = BC6H_UF16, 1 = BC6H_SF16 */
   uint bc_bx;        /* Real texture extent in BC6H blocks (X) */
   uint bc_by;        /* Real texture extent in BC6H blocks (Y) */
} pc;

