/* ---- Working texel grid (up to 64 texels, row-major, 0xAABBGGRR) ---- */
uint grid[64];
uint gchan(uint px, uint c) { return (grid[px] >> (c * 8u)) & 0xffu; }

/* ---- Safe source reader (bounds-checked against SrcBuf) ---- */
uint read_src(uint idx) {
   return (idx < uint(src.length())) ? src[idx] : 0u;
}

/* ---- BC1 decode (matches bcdec) ---- */
void decode_bc1(uint w0, inout uint out_grid[64]) {
   uint lo = read_src(w0), idx = read_src(w0 + 1u);
   uint c0 = lo & 0xffffu, c1 = lo >> 16u;
   uint r0=(c0>>11u)&0x1fu,g0=(c0>>5u)&0x3fu,b0=c0&0x1fu;
   uint r1=(c1>>11u)&0x1fu,g1=(c1>>5u)&0x3fu,b1=c1&0x1fu;
   uint ref[4]; uint r,g,b;
   r=(r0*527u+23u)>>6u;g=(g0*259u+33u)>>6u;b=(b0*527u+23u)>>6u;ref[0]=0xff000000u|(b<<16u)|(g<<8u)|r;
   r=(r1*527u+23u)>>6u;g=(g1*259u+33u)>>6u;b=(b1*527u+23u)>>6u;ref[1]=0xff000000u|(b<<16u)|(g<<8u)|r;
   if (c0 > c1) {
      r=((2u*r0+r1)*351u+61u)>>7u;g=((2u*g0+g1)*2763u+1039u)>>11u;b=((2u*b0+b1)*351u+61u)>>7u;ref[2]=0xff000000u|(b<<16u)|(g<<8u)|r;
      r=((r0+2u*r1)*351u+61u)>>7u;g=((g0+2u*g1)*2763u+1039u)>>11u;b=((b0+2u*b1)*351u+61u)>>7u;ref[3]=0xff000000u|(b<<16u)|(g<<8u)|r;
   } else {
      r=((r0+r1)*1053u+125u)>>8u;g=((g0+g1)*4145u+1019u)>>11u;b=((b0+b1)*1053u+125u)>>8u;ref[2]=0xff000000u|(b<<16u)|(g<<8u)|r;
      ref[3]=(pc.has_alpha!=0u)?0u:0xff000000u;
   }
   for (uint i=0u;i<16u;i++) out_grid[i]=ref[(idx>>(i*2u))&3u];
}

/* ---- BC7 decode (128-bit reader over 4 words; matches bcdec, host-validated) ---- */
uint B[4]; uint bitpos;
uint rd(uint n) { uint r=0u; for(uint i=0u;i<n;i++){uint bp=bitpos+i;r|=((B[bp>>5u]>>(bp&31u))&1u)<<i;} bitpos+=n; return r; }
int interp(int a,int b,int w) { return (a*(64-w)+b*w+32)>>6; }

void decode_bc7(uint w0, inout uint out_grid[64]) {
   for (uint i=0u;i<4u;i++) B[i]=read_src(w0+i);
   bitpos=0u;
   const int abc0[8]=int[](4,6,5,7,5,7,7,5);
   const int abc1[8]=int[](0,0,0,0,6,8,7,5);
   const int aW2[4]=int[](0,21,43,64);
   const int aW3[8]=int[](0,9,18,27,37,46,55,64);
   const int aW4[16]=int[](0,4,9,13,17,21,26,30,34,38,43,47,51,55,60,64);
   int mode=0; while(mode<8 && rd(1u)==0u) mode++;
   if (mode>=8) { for(uint i=0u;i<16u;i++) out_grid[i]=0u; return; }
   int numPart=1,part_idx=0,rotation=0,isb=0;
   if(mode==0||mode==1||mode==2||mode==3||mode==7){numPart=(mode==0||mode==2)?3:2;part_idx=int(rd((mode==0)?4u:6u));}
   int numEP=numPart*2;
   if(mode==4||mode==5){rotation=int(rd(2u));if(mode==4)isb=int(rd(1u));}
   int ep[6][4];
   for(int i=0;i<3;i++)for(int j=0;j<numEP;j++)ep[j][i]=int(rd(uint(abc0[mode])));
   if(abc1[mode]>0)for(int j=0;j<numEP;j++)ep[j][3]=int(rd(uint(abc1[mode])));
   int pbits=0xCB;
   if(mode==0||mode==1||mode==3||mode==6||mode==7){
      for(int i=0;i<numEP;i++)for(int j=0;j<4;j++)ep[i][j]<<=1;
      if(mode==1){int pi=int(rd(1u)),pj=int(rd(1u));for(int k=0;k<3;k++){ep[0][k]|=pi;ep[1][k]|=pi;ep[2][k]|=pj;ep[3][k]|=pj;}}
      else if((pbits&(1<<mode))!=0){for(int i=0;i<numEP;i++){int pj=int(rd(1u));for(int k=0;k<4;k++)ep[i][k]|=pj;}}
   }
   for(int i=0;i<numEP;i++){
      int j=abc0[mode]+((pbits>>mode)&1);
      for(int k=0;k<3;k++){ep[i][k]=ep[i][k]<<(8-j);ep[i][k]=ep[i][k]|(ep[i][k]>>j);}
      j=abc1[mode]+((pbits>>mode)&1);
      ep[i][3]=ep[i][3]<<(8-j);ep[i][3]=ep[i][3]|(ep[i][3]>>j);
   }
   if(abc1[mode]==0)for(int j=0;j<numEP;j++)ep[j][3]=0xFF;
   int indexBits=(mode==0||mode==1)?3:((mode==6)?4:2);
   int indexBits2=(mode==4)?3:((mode==5)?2:0);
   int idxs[16];
   for(int i=0;i<4;i++)for(int j=0;j<4;j++){
      int ps=(numPart==1)?(((i|j)!=0)?0:128):((numPart==3)?int(bc7_part3[part_idx*16+i*4+j]):int(bc7_part2[part_idx*16+i*4+j]));
      int ib=(mode==0||mode==1)?3:((mode==6)?4:2);
      if((ps&0x80)!=0)ib--;
      idxs[i*4+j]=int(rd(uint(ib)));
   }
   for(int i=0;i<4;i++)for(int j=0;j<4;j++){
      int psr=(numPart==1)?(((i|j)!=0)?0:128):((numPart==3)?int(bc7_part3[part_idx*16+i*4+j]):int(bc7_part2[part_idx*16+i*4+j]));
      int ps=psr&3;
      int idx=idxs[i*4+j],r,g,b,a;
      int w0i=(indexBits==2)?aW2[idx]:((indexBits==3)?aW3[idx]:aW4[idx]);
      if(indexBits2==0){
         r=interp(ep[ps*2][0],ep[ps*2+1][0],w0i);g=interp(ep[ps*2][1],ep[ps*2+1][1],w0i);
         b=interp(ep[ps*2][2],ep[ps*2+1][2],w0i);a=interp(ep[ps*2][3],ep[ps*2+1][3],w0i);
      } else {
         int idx2=int(rd(((i|j)!=0)?uint(indexBits2):uint(indexBits2-1)));
         int w2i=(indexBits2==2)?aW2[idx2]:aW3[idx2];
         if(isb==0){r=interp(ep[ps*2][0],ep[ps*2+1][0],w0i);g=interp(ep[ps*2][1],ep[ps*2+1][1],w0i);b=interp(ep[ps*2][2],ep[ps*2+1][2],w0i);a=interp(ep[ps*2][3],ep[ps*2+1][3],w2i);}
         else {r=interp(ep[ps*2][0],ep[ps*2+1][0],w2i);g=interp(ep[ps*2][1],ep[ps*2+1][1],w2i);b=interp(ep[ps*2][2],ep[ps*2+1][2],w2i);a=interp(ep[ps*2][3],ep[ps*2+1][3],w0i);}
      }
      if(rotation==1){int t=a;a=r;r=t;}else if(rotation==2){int t=a;a=g;g=t;}else if(rotation==3){int t=a;a=b;b=t;}
      out_grid[i*4+j]=uint(r)|(uint(g)<<8u)|(uint(b)<<16u)|(uint(a)<<24u);
   }
}

/* ============================================================================
 * Decodificadores BC2 / BC3 / BC4 / BC5
 * ========================================================================== */

void bc_alpha_palette(uint w0, out uint pal[8]) {
   uint word0 = read_src(w0);
   uint a0 = word0 & 0xffu;
   uint a1 = (word0 >> 8u) & 0xffu;
   pal[0] = a0;
   pal[1] = a1;
   if (a0 > a1) {
      pal[2] = (6u * a0 + a1) / 7u;
      pal[3] = (5u * a0 + 2u * a1) / 7u;
      pal[4] = (4u * a0 + 3u * a1) / 7u;
      pal[5] = (3u * a0 + 4u * a1) / 7u;
      pal[6] = (2u * a0 + 5u * a1) / 7u;
      pal[7] = (a0 + 6u * a1) / 7u;
   } else {
      pal[2] = (4u * a0 + a1) / 5u;
      pal[3] = (3u * a0 + 2u * a1) / 5u;
      pal[4] = (2u * a0 + 3u * a1) / 5u;
      pal[5] = (a0 + 4u * a1) / 5u;
      pal[6] = 0u;
      pal[7] = 255u;
   }
}

uint bc_alpha_index(uint w0, uint k) {
   uint p = 16u + 3u * k;
   uint wi = w0 + (p >> 5u);
   uint sh = p & 31u;
   uint v = read_src(wi) >> sh;
   if (sh > 29u) v |= read_src(wi + 1u) << (32u - sh);
   return v & 7u;
}

void bc_color_block_opaque(uint cw, inout uint rgb16[64]) {
   uint lo = read_src(cw), idx = read_src(cw + 1u);
   uint c0 = lo & 0xffffu, c1 = lo >> 16u;
   uint r0 = (c0 >> 11u) & 0x1fu, g0 = (c0 >> 5u) & 0x3fu, b0 = c0 & 0x1fu;
   uint r1 = (c1 >> 11u) & 0x1fu, g1 = (c1 >> 5u) & 0x3fu, b1 = c1 & 0x1fu;
   uint pal[4];
   uint r, g, b;
   r = (r0 * 527u + 23u) >> 6u; g = (g0 * 259u + 33u) >> 6u; b = (b0 * 527u + 23u) >> 6u;
   pal[0] = 0xff000000u | (b << 16u) | (g << 8u) | r;
   r = (r1 * 527u + 23u) >> 6u; g = (g1 * 259u + 33u) >> 6u; b = (b1 * 527u + 23u) >> 6u;
   pal[1] = 0xff000000u | (b << 16u) | (g << 8u) | r;
   r = ((2u * r0 + r1) * 351u + 61u) >> 7u; g = ((2u * g0 + g1) * 2763u + 1039u) >> 11u; b = ((2u * b0 + b1) * 351u + 61u) >> 7u;
   pal[2] = 0xff000000u | (b << 16u) | (g << 8u) | r;
   r = ((r0 + 2u * r1) * 351u + 61u) >> 7u; g = ((g0 + 2u * g1) * 2763u + 1039u) >> 11u; b = ((b0 + 2u * b1) * 351u + 61u) >> 7u;
   pal[3] = 0xff000000u | (b << 16u) | (g << 8u) | r;
   for (uint i = 0u; i < 16u; i++) rgb16[i] = pal[(idx >> (i * 2u)) & 3u];
}

void decode_bc2(uint w0, inout uint out_grid[64]) {
   bc_color_block_opaque(w0 + 2u, out_grid);
   for (uint i = 0u; i < 16u; i++) {
      uint row = i >> 2u, col = i & 3u;
      uint word = read_src(w0 + (row >> 1u));
      uint sh = (row & 1u) * 16u + col * 4u;
      uint a = ((word >> sh) & 15u) * 17u;
      out_grid[i] = (out_grid[i] & 0x00ffffffu) | (a << 24u);
   }
}

void decode_bc3(uint w0, inout uint out_grid[64]) {
   bc_color_block_opaque(w0 + 2u, out_grid);
   uint pal[8];
   bc_alpha_palette(w0, pal);
   for (uint i = 0u; i < 16u; i++) {
      uint a = pal[bc_alpha_index(w0, i)];
      out_grid[i] = (out_grid[i] & 0x00ffffffu) | (a << 24u);
   }
}

/* BC4 decoded as grayscale (R = G = B = v, A = 255) for faithful monochrome ASTC transcode */
void decode_bc4(uint w0, inout uint out_grid[64]) {
   uint pal[8];
   bc_alpha_palette(w0, pal);
   for (uint i = 0u; i < 16u; i++) {
      uint v = pal[bc_alpha_index(w0, i)];
      out_grid[i] = 0xff000000u | (v << 16u) | (v << 8u) | v;
   }
}

void decode_bc5(uint w0, inout uint out_grid[64]) {
   uint pal0[8], pal1[8];
   bc_alpha_palette(w0, pal0);
   bc_alpha_palette(w0 + 2u, pal1);
   for (uint i = 0u; i < 16u; i++) {
      uint r = pal0[bc_alpha_index(w0, i)];
      uint g = pal1[bc_alpha_index(w0 + 2u, i)];
      out_grid[i] = 0xff000000u | (g << 8u) | r;
   }
}

uint bc_block_words(uint fmt) { return (fmt == 0u || fmt == 4u) ? 2u : 4u; }

void decode_bc_any(uint fmt, uint w0, inout uint out_grid[64]) {
   if (fmt == 0u) decode_bc1(w0, out_grid);
   else if (fmt == 1u) decode_bc7(w0, out_grid);
   else if (fmt == 2u) decode_bc2(w0, out_grid);
   else if (fmt == 3u) decode_bc3(w0, out_grid);
   else if (fmt == 4u) decode_bc4(w0, out_grid);
   else decode_bc5(w0, out_grid);
}

/* ---- ASTC block assembly ---- */
void set_bits(inout uint out_blk[4], int pos, int count, uint value) {
   for (int i = 0; i < count; i++) {
      if ((value & (1u << uint(i))) != 0u) {
         int p = pos + i;
         out_blk[p >> 5] |= 1u << uint(p & 31);
      }
   }
}

uint rev_bits(uint v, int count) {
   uint o = 0u;
   for (int i = 0; i < count; i++) o |= ((v >> uint(i)) & 1u) << uint(count - 1 - i);
   return o;
}

const int trit_Tpos[8] = int[](4,5,10,11,16,21,22,27);
const int trit_Mpos[5] = int[](0,6,12,17,23);

void write_trit_ep(inout uint out_blk[4], int q[8]) {
   int base = 17;
   int t = int(astc_trit5[(q[0]>>4)+3*(q[1]>>4)+9*(q[2]>>4)+27*(q[3]>>4)+81*(q[4]>>4)]);
   for (int j = 0; j < 5; j++) set_bits(out_blk, base + trit_Mpos[j], 4, uint(q[j] & 15));
   for (int j = 0; j < 8; j++) if (((t >> j) & 1) != 0) set_bits(out_blk, base + trit_Tpos[j], 1, 1u);
   base = 45;
   int t3 = int(astc_trit3[(q[5]>>4)+3*(q[6]>>4)+9*(q[7]>>4)]);
   for (int j = 0; j < 3; j++) set_bits(out_blk, base + trit_Mpos[j], 4, uint(q[5+j] & 15));
   for (int j = 0; j < 5; j++) if (((t3 >> j) & 1) != 0) set_bits(out_blk, base + trit_Tpos[j], 1, 1u);
}

int quant_ce(int v) {
   v = clamp(v, 0, 255);
   return int(astc_ce_quant[v]);
}

/* Fast extreme-candidate endpoint finder over `count` texels in `grid`.
 * Uses R, G, B and luma extremes (up to 8 candidates, <=28 pairs) instead of O(N^2). */
void find_endpoints_grid(int count, out int lo_out, out int hi_out) {
   int cand[8];
   for (int k = 0; k < 8; k++) cand[k] = 0;
   int min_r = 256, max_r = -1;
   int min_g = 256, max_g = -1;
   int min_b = 256, max_b = -1;
   int min_l = 1024, max_l = -1;
   for (int i = 0; i < count; i++) {
      int r = int(gchan(uint(i), 0u));
      int g = int(gchan(uint(i), 1u));
      int b = int(gchan(uint(i), 2u));
      int l = r + g + b;
      if (r < min_r) { min_r = r; cand[0] = i; }
      if (r > max_r) { max_r = r; cand[1] = i; }
      if (g < min_g) { min_g = g; cand[2] = i; }
      if (g > max_g) { max_g = g; cand[3] = i; }
      if (b < min_b) { min_b = b; cand[4] = i; }
      if (b > max_b) { max_b = b; cand[5] = i; }
      if (l < min_l) { min_l = l; cand[6] = i; }
      if (l > max_l) { max_l = l; cand[7] = i; }
   }
   int ai = cand[6], bi = cand[7], best = -1;
   for (int a = 0; a < 8; a++) {
      for (int b = a + 1; b < 8; b++) {
         int ia = cand[a], ib = cand[b];
         int dr = int(gchan(uint(ia), 0u)) - int(gchan(uint(ib), 0u));
         int dg = int(gchan(uint(ia), 1u)) - int(gchan(uint(ib), 1u));
         int db = int(gchan(uint(ia), 2u)) - int(gchan(uint(ib), 2u));
         int d2 = dr * dr + dg * dg + db * db;
         if (d2 > best) { best = d2; ai = ia; bi = ib; }
      }
   }
   int sa = int(gchan(uint(ai), 0u) + gchan(uint(ai), 1u) + gchan(uint(ai), 2u));
   int sb = int(gchan(uint(bi), 0u) + gchan(uint(bi), 1u) + gchan(uint(bi), 2u));
   lo_out = (sb >= sa) ? ai : bi;
   hi_out = (sb >= sa) ? bi : ai;
}

/* Lightweight 4x4 grid average for 6x6 (stride 6) or 8x8 (stride 8) without large pinv tables */
float sample_grid4_weight(int gx, int gy, int stride, int dim, int e0r, int e0g, int e0b, int dr, int dg, int db, float inv_dlen2, float max_w) {
   if (dr == 0 && dg == 0 && db == 0) return 0.0;
   float sum = 0.0;
   float cnt = 0.0;
   int x0 = (gx * dim) / 4;
   int x1 = max(x0 + 1, ((gx + 1) * dim) / 4);
   int y0 = (gy * dim) / 4;
   int y1 = max(y0 + 1, ((gy + 1) * dim) / 4);
   for (int y = y0; y < y1; y++) {
      for (int x = x0; x < x1; x++) {
         uint idx = uint(y * stride + x);
         int dot = (int(gchan(idx, 0u)) - e0r) * dr +
                   (int(gchan(idx, 1u)) - e0g) * dg +
                   (int(gchan(idx, 2u)) - e0b) * db;
         sum += clamp(float(dot) * inv_dlen2, 0.0, 1.0) * max_w;
         cnt += 1.0;
      }
   }
   return (cnt > 0.0) ? (sum / cnt) : 0.0;
}

float sample_grid4_chan(int gx, int gy, int stride, int dim, uint ch, int min_v, float inv_range, float max_w) {
   float sum = 0.0;
   float cnt = 0.0;
   int x0 = (gx * dim) / 4;
   int x1 = max(x0 + 1, ((gx + 1) * dim) / 4);
   int y0 = (gy * dim) / 4;
   int y1 = max(y0 + 1, ((gy + 1) * dim) / 4);
   for (int y = y0; y < y1; y++) {
      for (int x = x0; x < x1; x++) {
         uint idx = uint(y * stride + x);
         sum += clamp(float(int(gchan(idx, ch)) - min_v) * inv_range, 0.0, 1.0) * max_w;
         cnt += 1.0;
      }
   }
   return (cnt > 0.0) ? (sum / cnt) : 0.0;
}

/* ---- Unified RGB / RGBA / RG encoders over `count` texels (16, 36, or 64) ---- */
void encode_rgb_grid(int count, out uint out_blk[4]) {
   out_blk[0] = 0u; out_blk[1] = 0u; out_blk[2] = 0u; out_blk[3] = 0u;
   int lo, hi;
   find_endpoints_grid(count, lo, hi);
   int e0r = int(gchan(uint(lo), 0u)), e0g = int(gchan(uint(lo), 1u)), e0b = int(gchan(uint(lo), 2u));
   int e1r = int(gchan(uint(hi), 0u)), e1g = int(gchan(uint(hi), 1u)), e1b = int(gchan(uint(hi), 2u));
   set_bits(out_blk, 0, 11, 0x53u);
   set_bits(out_blk, 13, 4, 8u);
   set_bits(out_blk, 17, 8, uint(e0r)); set_bits(out_blk, 25, 8, uint(e1r));
   set_bits(out_blk, 33, 8, uint(e0g)); set_bits(out_blk, 41, 8, uint(e1g));
   set_bits(out_blk, 49, 8, uint(e0b)); set_bits(out_blk, 57, 8, uint(e1b));
   int dr = e1r - e0r, dg = e1g - e0g, db = e1b - e0b;
   int dlen2 = dr * dr + dg * dg + db * db;
   float inv_dlen2 = (dlen2 > 0) ? (1.0 / float(dlen2)) : 0.0;

   if (count == 16) {
      for (int t = 0; t < 16; t++) {
         uint q = 0u;
         if (dlen2 > 0) {
            int dot = (int(gchan(uint(t), 0u)) - e0r) * dr +
                      (int(gchan(uint(t), 1u)) - e0g) * dg +
                      (int(gchan(uint(t), 2u)) - e0b) * db;
            if (dot >= dlen2) q = 7u;
            else if (dot > 0) q = uint((dot * 7 + dlen2 / 2) / dlen2);
         }
         set_bits(out_blk, 128 - (t + 1) * 3, 3, rev_bits(q, 3));
      }
   } else {
      int dim = (count == 64) ? 8 : 6;
      for (int g = 0; g < 16; g++) {
         int gx = g & 3, gy = g >> 2;
         float w = sample_grid4_weight(gx, gy, dim, dim, e0r, e0g, e0b, dr, dg, db, inv_dlen2, 7.0);
         int q = clamp(int(floor(w + 0.5)), 0, 7);
         set_bits(out_blk, 128 - (g + 1) * 3, 3, rev_bits(uint(q), 3));
      }
   }
}

void encode_rgba_grid(int count, out uint out_blk[4]) {
   out_blk[0] = 0u; out_blk[1] = 0u; out_blk[2] = 0u; out_blk[3] = 0u;
   set_bits(out_blk, 0, 11, 0x442u);
   set_bits(out_blk, 13, 4, 12u);
   int lo, hi;
   find_endpoints_grid(count, lo, hi);
   int amin = 255, amax = 0;
   for (int i = 0; i < count; i++) {
      int a = int(gchan(uint(i), 3u));
      if (a < amin) amin = a;
      if (a > amax) amax = a;
   }
   int e0r = int(gchan(uint(lo), 0u)), e0g = int(gchan(uint(lo), 1u)), e0b = int(gchan(uint(lo), 2u));
   int e1r = int(gchan(uint(hi), 0u)), e1g = int(gchan(uint(hi), 1u)), e1b = int(gchan(uint(hi), 2u));
   int q[8] = int[](
      quant_ce(e0r), quant_ce(e1r),
      quant_ce(e0g), quant_ce(e1g),
      quant_ce(e0b), quant_ce(e1b),
      quant_ce(amin), quant_ce(amax)
   );
   int s0 = int(astc_ce_unq[q[0]]) + int(astc_ce_unq[q[2]]) + int(astc_ce_unq[q[4]]);
   int s1 = int(astc_ce_unq[q[1]]) + int(astc_ce_unq[q[3]]) + int(astc_ce_unq[q[5]]);
   int swap = (s1 < s0) ? 1 : 0;
   if (swap != 0) {
      for (int k = 0; k < 8; k += 2) {
         int tmp = q[k]; q[k] = q[k + 1]; q[k + 1] = tmp;
      }
   }
   write_trit_ep(out_blk, q);
   set_bits(out_blk, 62, 2, 3u);

   int u0r = int(astc_ce_unq[q[0]]), u1r = int(astc_ce_unq[q[1]]);
   int u0g = int(astc_ce_unq[q[2]]), u1g = int(astc_ce_unq[q[3]]);
   int u0b = int(astc_ce_unq[q[4]]), u1b = int(astc_ce_unq[q[5]]);
   int dr = u1r - u0r, dg = u1g - u0g, db = u1b - u0b;
   int dlen2 = dr * dr + dg * dg + db * db;
   float inv_dlen2 = (dlen2 > 0) ? (1.0 / float(dlen2)) : 0.0;
   int arange = amax - amin;
   float inv_arange = (arange > 0) ? (1.0 / float(arange)) : 0.0;

   if (count == 16) {
      for (int px = 0; px < 16; px++) {
         uint q0 = 0u;
         if (dlen2 > 0) {
            int dot = (int(gchan(uint(px), 0u)) - u0r) * dr +
                      (int(gchan(uint(px), 1u)) - u0g) * dg +
                      (int(gchan(uint(px), 2u)) - u0b) * db;
            if (dot >= dlen2) q0 = 3u;
            else if (dot > 0) q0 = uint((dot * 3 + dlen2 / 2) / dlen2);
         }
         uint q1 = 0u;
         if (arange > 0) {
            int a = int(gchan(uint(px), 3u)) - amin;
            int t = (a * 3 + arange / 2) / arange;
            q1 = uint(clamp(t, 0, 3));
         }
         if (swap != 0) { q0 = 3u - q0; q1 = 3u - q1; }
         set_bits(out_blk, 128 - (2 * px + 1) * 2, 2, rev_bits(q0, 2));
         set_bits(out_blk, 128 - (2 * px + 2) * 2, 2, rev_bits(q1, 2));
      }
   } else {
      int dim = (count == 64) ? 8 : 6;
      for (int g = 0; g < 16; g++) {
         int gx = g & 3, gy = g >> 2;
         float w0 = sample_grid4_weight(gx, gy, dim, dim, u0r, u0g, u0b, dr, dg, db, inv_dlen2, 3.0);
         float w1 = (arange > 0) ? sample_grid4_chan(gx, gy, dim, dim, 3u, amin, inv_arange, 3.0) : 0.0;
         if (swap != 0) { w0 = 3.0 - w0; w1 = 3.0 - w1; }
         int q0 = clamp(int(floor(w0 + 0.5)), 0, 3);
         int q1 = clamp(int(floor(w1 + 0.5)), 0, 3);
         set_bits(out_blk, 128 - (2 * g + 1) * 2, 2, rev_bits(uint(q0), 2));
         set_bits(out_blk, 128 - (2 * g + 2) * 2, 2, rev_bits(uint(q1), 2));
      }
   }
}

void encode_rg_grid(int count, out uint out_blk[4]) {
   out_blk[0] = 0u; out_blk[1] = 0u; out_blk[2] = 0u; out_blk[3] = 0u;
   set_bits(out_blk, 0, 11, 0x442u);
   set_bits(out_blk, 13, 4, 12u);
   int rmin = 255, rmax = 0, gmin = 255, gmax = 0;
   for (int i = 0; i < count; i++) {
      int r = int(gchan(uint(i), 0u)), g = int(gchan(uint(i), 1u));
      if (r < rmin) rmin = r; if (r > rmax) rmax = r;
      if (g < gmin) gmin = g; if (g > gmax) gmax = g;
   }
   int q[8] = int[](
      quant_ce(rmin), quant_ce(rmax),
      quant_ce(gmin), quant_ce(gmax),
      quant_ce(0), quant_ce(0),
      quant_ce(255), quant_ce(255)
   );
   write_trit_ep(out_blk, q);
   set_bits(out_blk, 62, 2, 1u);
   int r0 = int(astc_ce_unq[q[0]]), r1 = int(astc_ce_unq[q[1]]);
   int g0 = int(astc_ce_unq[q[2]]), g1 = int(astc_ce_unq[q[3]]);
   int rrange = r1 - r0, grange = g1 - g0;
   float inv_rrange = (rrange > 0) ? (1.0 / float(rrange)) : 0.0;
   float inv_grange = (grange > 0) ? (1.0 / float(grange)) : 0.0;

   if (count == 16) {
      for (int px = 0; px < 16; px++) {
         uint q0 = 0u, q1 = 0u;
         if (rrange > 0) {
            int v = int(gchan(uint(px), 0u)) - r0;
            q0 = (v <= 0) ? 0u : (v >= rrange ? 3u : uint((v * 3 + rrange / 2) / rrange));
         }
         if (grange > 0) {
            int v = int(gchan(uint(px), 1u)) - g0;
            q1 = (v <= 0) ? 0u : (v >= grange ? 3u : uint((v * 3 + grange / 2) / grange));
         }
         set_bits(out_blk, 128 - (2 * px + 1) * 2, 2, rev_bits(q0, 2));
         set_bits(out_blk, 128 - (2 * px + 2) * 2, 2, rev_bits(q1, 2));
      }
   } else {
      int dim = (count == 64) ? 8 : 6;
      for (int g = 0; g < 16; g++) {
         int gx = g & 3, gy = g >> 2;
         float w0 = (rrange > 0) ? sample_grid4_chan(gx, gy, dim, dim, 0u, r0, inv_rrange, 3.0) : 0.0;
         float w1 = (grange > 0) ? sample_grid4_chan(gx, gy, dim, dim, 1u, g0, inv_grange, 3.0) : 0.0;
         int q0 = clamp(int(floor(w0 + 0.5)), 0, 3);
         int q1 = clamp(int(floor(w1 + 0.5)), 0, 3);
         set_bits(out_blk, 128 - (2 * g + 1) * 2, 2, rev_bits(uint(q0), 2));
         set_bits(out_blk, 128 - (2 * g + 2) * 2, 2, rev_bits(uint(q1), 2));
      }
   }
}

void encode_grid(int count, out uint out_blk[4]) {
   if (pc.format == 5u) encode_rg_grid(count, out_blk);
   else if (pc.has_alpha != 0u) encode_rgba_grid(count, out_blk);
   else encode_rgb_grid(count, out_blk);
}

void main() {
   uint bx = gl_GlobalInvocationID.x, by = gl_GlobalInvocationID.y;
   if (bx >= pc.block_x || by >= pc.block_y) return;

   uint words = bc_block_words(pc.format);
   uint out_blk[4];

   if (pc.astc8 == 1u) {
      /* 8x8 ASTC block from 2x2 group of BC blocks */
      uint sub64[64];
      for (uint dy = 0u; dy < 2u; dy++) {
         for (uint dx = 0u; dx < 2u; dx++) {
            uint bcx = 2u * bx + dx, bcy = 2u * by + dy;
            if (bcx < pc.bc_bx && bcy < pc.bc_by) {
               uint srcWord = pc.src_word_off + (bcy * pc.block_x_src + bcx) * words;
               decode_bc_any(pc.format, srcWord, sub64);
            } else {
               for (uint i = 0u; i < 16u; i++) sub64[i] = 0u;
            }
            for (uint r = 0u; r < 4u; r++) {
               for (uint c = 0u; c < 4u; c++) {
                  grid[(dy * 4u + r) * 8u + (dx * 4u + c)] = sub64[r * 4u + c];
               }
            }
         }
      }
      encode_grid(64, out_blk);
   } else if (pc.astc8 == 2u) {
      /* 6x6 ASTC block starting at pixel (6*bx, 6*by), clamped to valid BC block bounds */
      for (uint i = 0u; i < 36u; i++) grid[i] = 0u;
      uint px0 = 6u * bx, py0 = 6u * by;
      uint bcx0 = px0 >> 2u, bcy0 = py0 >> 2u;
      uint bcx1 = min((px0 + 5u) >> 2u, (pc.bc_bx > 0u) ? (pc.bc_bx - 1u) : 0u);
      uint bcy1 = min((py0 + 5u) >> 2u, (pc.bc_by > 0u) ? (pc.bc_by - 1u) : 0u);
      uint sub64[64];
      if (pc.bc_bx > 0u && pc.bc_by > 0u) {
         for (uint bcy = bcy0; bcy <= bcy1; bcy++) {
            for (uint bcx = bcx0; bcx <= bcx1; bcx++) {
               uint srcWord = pc.src_word_off + (bcy * pc.block_x_src + bcx) * words;
               decode_bc_any(pc.format, srcWord, sub64);
               uint bpx = bcx << 2u, bpy = bcy << 2u;
               for (uint r = 0u; r < 4u; r++) {
                  uint y = bpy + r;
                  if (y < py0 || y >= py0 + 6u) continue;
                  for (uint c = 0u; c < 4u; c++) {
                     uint x = bpx + c;
                     if (x < px0 || x >= px0 + 6u) continue;
                     grid[(y - py0) * 6u + (x - px0)] = sub64[r * 4u + c];
                  }
               }
            }
         }
      }
      encode_grid(36, out_blk);
   } else {
      /* 4x4 ASTC block from 1 BC block */
      uint srcWord = pc.src_word_off + (by * pc.block_x_src + bx) * words;
      decode_bc_any(pc.format, srcWord, grid);
      encode_grid(16, out_blk);
   }

   uint dstWord = (by * pc.block_x + bx) * 4u;
   if (dstWord + 3u < uint(dst.length())) {
      dst[dstWord + 0u] = out_blk[0];
      dst[dstWord + 1u] = out_blk[1];
      dst[dstWord + 2u] = out_blk[2];
      dst[dstWord + 3u] = out_blk[3];
   }
}
