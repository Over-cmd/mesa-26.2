/*
 * BCn -> ASTC transcode compute shader. One invocation per ASTC block:
 * decode the BC block(s) to RGBA texels, run the ASTC encoder, write one 16-byte ASTC block.
 * format: 0=BC1, 1=BC7, 2=BC2, 3=BC3, 4=BC4, 5=BC5.   (BC6H is HDR and is not handled here.)
 * astc8:  0=4x4 ASTC, 1=8x8 ASTC (2x2 BC blocks), 2=6x6 ASTC (2x2 BC blocks, top-left 6x6).
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer SrcBuf { uint src[]; };
layout(std430, binding = 1) writeonly buffer DstBuf { uint dst[]; };
layout(push_constant) uniform PC {
   uint block_x; uint block_x_src; uint block_y; uint src_word_off;
   uint format; uint has_alpha;
   uint astc8; uint bc_bx; uint bc_by;
} pc;

